{
  "name": "sparql-formatter",
  "displayName": "SPARQL Formatter",
  "description": "Format and beautify SPARQL queries",
  "version": "0.0.2",
  "publisher": "your-publisher-name",
  "engines": {
    "vscode": "^1.108.1"
  },
  "categories": [
    "Formatters"
  ],
  "keywords": [
    "sparql",
    "rdf",
    "semantic web",
    "formatter",
    "beautify"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "sparql-formatter.format",
        "title": "Format SPARQL Document",
        "category": "SPARQL"
      },
      {
        "command": "sparql-formatter.formatSelection",
        "title": "Format SPARQL Selection",
        "category": "SPARQL"
      }
    ],
    "languages": [
      {
        "id": "sparql",
        "aliases": ["SPARQL", "sparql"],
        "extensions": [".sparql", ".rq"],
        "configuration": "./language-configuration.json"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "sparql-formatter.format",
          "when": "editorTextFocus && resourceExtname =~ /\\.(sparql|rq)$/",
          "group": "1_modification"
        },
        {
          "command": "sparql-formatter.formatSelection",
          "when": "editorHasSelection && resourceExtname =~ /\\.(sparql|rq)$/",
          "group": "1_modification"
        }
      ],
      "commandPalette": [
        {
          "command": "sparql-formatter.format",
          "when": "resourceExtname =~ /\\.(sparql|rq)$/"
        },
        {
          "command": "sparql-formatter.formatSelection",
          "when": "editorHasSelection && resourceExtname =~ /\\.(sparql|rq)$/"
        }
      ]
    },
    "keybindings": [
      {
        "command": "sparql-formatter.format",
        "key": "shift+alt+f",
        "when": "editorTextFocus && resourceExtname =~ /\\.(sparql|rq)$/"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.108.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.54.0",
    "eslint": "^9.39.2",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
